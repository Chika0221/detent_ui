        {
          "type": "text",
          "id": "DvQur",
          "x": 64,
          "y": 1310,
          "name": "Status semantics and value contract",
          "fill": "$ds.text.secondary",
          "textGrowth": "fixed-width",
          "width": 1440,
          "content": "Connected = link available · Disconnected = no link · Processing = outcome pending.\nProgress: active = floor(clamp(value, 0, 100) × rows × columns / 100), row-major.\nLevel: bottom-up per channel. Signal: ascending bars. Loading: unknown progress, never a fabricated percentage.",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
