          "height": 72
        },
        {
          "type": "text",
          "id": "UMZsS",
          "x": 88,
          "y": 930,
          "name": "Governance rule",
          "fill": "$perforation.hole.active",
          "content": "ADMISSION RULE",
          "lineHeight": 1.4,
          "fontFamily": "$font.latin",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "a6Zgb",
          "x": 240,
          "y": 926,
          "name": "Governance copy",
          "fill": "$ds.text.inverse",
          "textGrowth": "fixed-width",
          "width": 1240,
          "content": "A proposal must preserve geometry, state semantics, reduced-motion fallback, and content-safe coverage before entering the subsystem.",
          "lineHeight": 1.4,
          "fontFamily": "$font.latin",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "wpwwX",
          "x": 64,
          "y": 1050,
          "name": "Instance property contract heading",
          "fill": "$ds.text.primary",
          "textGrowth": "fixed-width",
          "width": 1450,
          "content": "Component contracts / editable instances",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 24,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "HMVvC",
          "x": 64,
          "y": 1100,
          "name": "Primitive instance specification",
          "fill": "$ds.text.primary",
          "textGrowth": "fixed-width",
          "width": 1450,
          "content": "Hole · Size 2 / 3 / 4 / 6; Depth 0 / 1 / 2px; inactive / active / highlighted / disabled; theme mode.\nGrid · Rows × Columns from enabled cells; pitch = diameter + gap; Square (c·p, r·p); Hex (c·p + (r%2)·p/2, r·p·√3/2).\nPattern · Full / Edge / Corner / Custom masks; content clearance ≥ 16px; resize by changing rows / columns, never stretch circles.",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "U8Wfzn",
          "x": 64,
          "y": 1240,
          "name": "Core instance specification",
          "fill": "$ds.text.primary",
          "textGrowth": "fixed-width",
          "width": 1450,
          "content": "Surface · five visual recipes; sparse / normal / dense minimum gaps; responsive area uses extra whole rows / columns.\nResonance · Idle / Hover / Active / Pulse / Listening / Disabled; 90 / 160 / 220ms; radius ≤ 3 cells; no independent hole targets.\nMatrix · Progress / Status / Level / Signal / Loading; label + value; horizontal / vertical reading order must be explicit.",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "h8WH4X",
          "x": 64,
          "y": 1380,
          "name": "Implementation boundary",
          "fill": "$ds.text.secondary",
          "textGrowth": "fixed-width",
          "width": 1450,
          "content": "Pen implements linked symbols, instance overrides, theme aliases and static keyframes. Runtime row generation, pointer/audio input, animation, reduced-motion detection and accessible semantics belong in Flutter / Rive. Decorative geometry must never control application state.",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    }
  ],
