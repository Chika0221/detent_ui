        },
        {
          "type": "text",
          "id": "c9mDW",
          "x": 64,
          "y": 950,
          "name": "Token mapping",
          "fill": "$perforation.text.primary",
          "textGrowth": "fixed-width",
          "width": 1450,
          "content": "surface → ds.bg.surface · active → ds.action.primary · status → ds.status.* · type → existing font roles.\nDark aliases reuse DS02: surface #24272A / raised #353A3E / text #F2F4F1 / secondary #ADB6BC / border #8A959A.",
          "lineHeight": 1.4,
          "fontFamily": "$font.latin",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "IfZMt",
          "x": 64,
          "y": 1060,
          "name": "Complete alias and motion registry",
          "fill": "$ds.text.primary",
          "textGrowth": "fixed-width",
          "width": 1450,
          "content": "Additional bindings / no new brand palette",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 23,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "WMu5x",
          "x": 64,
          "y": 1110,
          "name": "Theme alias registry",
          "fill": "$ds.text.primary",
          "textGrowth": "fixed-width",
          "width": 720,
          "content": "perforation.raised → ds.bg.raised (Light), existing DS02 raised (Dark)\nperforation.text.primary / secondary → existing DS text roles\nperforation.border → existing DS control boundary\nperforation.hole.rim / muted → material edge / inactive aperture; theme-aware",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "suB0Y",
          "x": 820,
          "y": 1110,
          "name": "Motion token registry",
          "fill": "$ds.text.primary",
          "textGrowth": "fixed-width",
          "width": 690,
          "content": "perforation.motion.easing = cubic-bezier(0.2, 0, 0, 1)\nperforation.motion.intensity = 0.24 (maximum opacity delta)\nperforation.depth.flat / inset / deep = 0 / 1 / 2px inner offset\nperforation.hole.active = $ds.action.primary (both modes)",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "boqo1",
          "x": 64,
          "y": 1300,
          "name": "Token property distinction",
          "fill": "$ds.text.secondary",
          "textGrowth": "fixed-width",
          "width": 1420,
          "content": "Native variables store numbers, colors and easing strings. Geometry uses numeric instance dimensions matching the token values. Rows / Columns / Arrangement / Density / Coverage / State are documented instance recipes; this Pen library has no automatic value-to-grid binding.",
          "lineHeight": 1.6,
          "fontFamily": "$font.latin",
          "fontSize": 15,
          "fontWeight": "normal"
        }
      ]
    },
